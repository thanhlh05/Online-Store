                  "});\r",
                  "\r",
                  "// Chuyển dữ liệu trả về thành JSON\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// Tìm và lưu JWT Token vào biến môi trường 'token'\r",
                  "if (jsonData.token) {\r",
                  "    pm.environment.set(\"token\", jsonData.token);\r",
                  "    console.log(\"Đã lưu token thành công!\");\r",
                  "} else if (jsonData.jwt) {\r",
                  "    pm.environment.set(\"token\", jsonData.jwt);\r",
                  "    console.log(\"Đã lưu token thành công!\");\r",
                  "}"
